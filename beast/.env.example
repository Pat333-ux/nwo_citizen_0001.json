# Example values only. Copy to .env locally and replace all placeholders.
# Keep .env private; it is ignored by Git.
POSTGRES_PASSWORD=replace-this-local-db-password
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:replace-this-local-db-password@127.0.0.1:5432/beast
JWT_SECRET=replace-with-at-least-32-random-characters
PII_KEY_HEX=replace-with-64-hexadecimal-characters
POVERTY_LEVEL_MONTHLY=1234
BOOTSTRAP_ADMIN_PASSWORD=
PORT=3000
# Set to 1 only when using the local Compose PostgreSQL service.
START_LOCAL_DB=1
