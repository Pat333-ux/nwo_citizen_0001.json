[
  {
    "id": "pslf",
    "name": "Public Service Loan Forgiveness",
    "agency": "Department of Education",
    "debtType": [
      "student-loan"
    ],
    "level": "federal",
    "description": "Cancels remaining Direct Loan balance after 120 qualifying payments while working full-time for a qualifying public service employer.",
    "eligibility": {
      "requirements": [
        "Direct Loans only or consolidated into Direct",
        "120 qualifying monthly payments",
        "Full-time employment at qualifying public service employer"
      ],
      "rules": [
        {
          "field": "studentLoans.directLoan",
          "op": "isTrue"
        },
        {
          "field": "employment.publicServiceEmployer",
          "op": "isTrue"
        },
        {
          "field": "studentLoans.qualifyingPayments",
          "op": "gte",
          "value": 120
        }
      ]
    },
    "application": {
      "forms": [
        "PSLF Application",
        "Employment Certification Form"
      ],
      "instructions": "Submit employment certification regularly and PSLF application after 120 qualifying payments.",
      "autoFill": {
        "fullName": "name",
        "email": "contact.email",
        "employer": "employment.employerName"
      }
    },
    "source_urls": [
      "https://studentaid.gov/pslf/"
    ],
    "last_verified": "2026-10-06"
  },
  {
    "id": "sl-idr",
    "name": "Income-Driven Repayment Plan Forgiveness",
    "agency": "U.S. Department of Education (StudentAid.gov)",
    "debtType": [
      "student-loan"
    ],
    "level": "federal",
    "description": "Income-Driven Repayment Plan Forgiveness (U.S. Department of Education (StudentAid.gov)).",
    "eligibility": {
      "requirements": [
        "studentLoans.federal is true",
        "studentLoans.yearsInRepayment >= 20"
      ],
      "rules": [
        {
          "field": "studentLoans.federal",
          "op": "isTrue"
        },
        {
          "field": "studentLoans.yearsInRepayment",
          "op": "gte",
          "value": 20
        }
      ]
    },
    "application": {
      "forms": [
        "IDR Application"
      ],
      "instructions": "Apply for an income-driven plan at StudentAid.gov. Recertify income annually.",
      "autoFill": {
        "fullName": "name",
        "email": "contact.email",
        "income": "income.annual"
      }
    },
    "source_urls": [
      "https://studentaid.gov/manage-loans/repayment/plans/income-driven"
    ],
    "last_verified": "2026-01-01"
  },
