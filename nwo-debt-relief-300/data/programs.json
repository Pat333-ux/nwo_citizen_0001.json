    "id": "tax-oic",
    "name": "IRS Offer in Compromise",
    "agency": "Internal Revenue Service",
    "debtType": [
      "tax"
    ],
    "level": "federal",
    "description": "IRS Offer in Compromise (Internal Revenue Service).",
    "eligibility": {
      "requirements": [
        "tax.owesIRS is true",
        "tax.canPayInFull != true"
      ],
      "rules": [
        {
          "field": "tax.owesIRS",
          "op": "isTrue"
        },
        {
          "field": "tax.canPayInFull",
          "op": "neq",
          "value": true
        }
      ]
    },
    "application": {
      "forms": [
        "Form 656",
        "Form 433-A (OIC)"
      ],
      "instructions": "Use the IRS Offer in Compromise Pre-Qualifier. Submit forms with the application fee or low-income waiver.",
      "autoFill": {
        "fullName": "name",
        "ssn": "tax.ssnLast4",
        "balanceOwed": "tax.balanceOwed"
      }
    },
    "source_urls": [
      "https://www.irs.gov/payments/offer-in-compromise"
    ],
    "last_verified": "2026-01-01"
  },
