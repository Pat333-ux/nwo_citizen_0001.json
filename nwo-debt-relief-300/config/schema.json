{
  "$id": "https://nwo.example.org/debt-relief-program.schema.json",
  "type": "object",
  "required": ["id", "name", "agency", "debtType", "level", "description", "eligibility", "application", "source_urls", "last_verified"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "agency": { "type": "string" },
    "debtType": { "type": "array", "items": { "type": "string" } },
    "level": { "type": "string", "enum": ["federal", "state"] },
    "description": { "type": "string" },
    "eligibility": {
      "type": "object",
      "required": ["requirements"],
      "properties": {
        "requirements": { "type": "array", "items": { "type": "string" }, "description": "Human-readable requirements" },
        "rules": {
          "type": "array",
          "description": "Optional machine-evaluable rules used by the engine. Programs without rules are never auto-matched.",
          "items": {
            "type": "object",
            "required": ["field", "op"],
            "properties": {
              "field": { "type": "string" },
              "op": { "enum": ["eq", "neq", "gt", "gte", "lt", "lte", "in", "exists", "isTrue"] },
              "value": {}
            }
          }
        }
      }
    },
    "application": {
      "type": "object",
      "required": ["forms", "instructions"],
      "properties": {
        "forms": { "type": "array", "items": { "type": "string" } },
        "instructions": { "type": "string" },
        "autoFill": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Optional: form field -> member profile dot path" }
      }
    },
    "source_urls": { "type": "array", "items": { "type": "string", "format": "uri" } },
    "last_verified": { "type": "string", "format": "date" }
  }
}
