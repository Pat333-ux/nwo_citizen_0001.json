{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DebtReliefProgram",
  "type": "object",
  "required": ["id", "name", "category", "agency", "eligibility", "application", "source_urls", "last_verified"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "category": { "enum": ["student-loan", "tax", "sba", "mortgage", "utility", "medical", "emergency"] },
    "agency": { "type": "string" },
    "eligibility": {
      "type": "object",
      "required": ["requirements"],
      "properties": {
        "requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["field", "op"],
            "properties": {
              "field": { "type": "string", "description": "Dot path into the member profile" },
              "op": { "enum": ["eq", "neq", "gt", "gte", "lt", "lte", "in", "exists", "isTrue"] },
              "value": {}
            }
          }
        }
      }
    },
    "application": {
      "type": "object",
      "required": ["forms", "instructions", "autoFill"],
      "properties": {
        "forms": { "type": "array", "items": { "type": "string" } },
        "instructions": { "type": "array", "items": { "type": "string" } },
        "autoFill": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Form field -> member profile dot path" }
      }
    },
    "source_urls": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uri" } },
    "last_verified": { "type": "string", "format": "date" }
  }
}
